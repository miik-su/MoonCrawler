----
import {
  "moonbitlang/async@0.22.5", "moonbitlang/async@0.22.5/shell", "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/json", "moonbitlang/core/env",
}
----
async fn run(program : String, args : Array[String]) -> (Int, String) {
  let out = @shell.Cmd(program, args).output(timeout_ms=300000, max_output_bytes=8388608)
  let text = (out.stdout() + out.stderr()).replace_all(old="C:\\Users\\MIKE", new="<user>").replace_all(old="C:/Users/MIKE", new="<user>")
  (out.exit_code(), text)
}
async fn main {
  let date = @env.args().get(1).unwrap_or("2026-11-13-0.2.3")
  assert_true(date.length() > 0 && date.length() <= 40 && !date.contains("..") && date.iter().all(c => (c >= '0' && c <= '9') || c == '-' || c == '.'))
  let revision = run("git", ["rev-parse", "HEAD"]).1.trim().to_owned()
  let dirty = !run("git", ["status", "--porcelain", "--", ".", ":(exclude)evidence"]).1.trim().is_empty()
  let versions = run("moon", ["version", "--all"]).1
  let platform = match @async.platform { Windows => "Windows"; Linux => "Linux"; MacOS => "macOS" }
  let groups : Array[(String, Array[String])] = [
    ("contracts", ["storage/page_validation_test.mbt", "engine/contracts_test.mbt"]),
    ("resources", ["robots/resource_test.mbt", "robots/capacity_test.mbt", "storage/capacity_test.mbt"]),
    ("queue", ["frontier/host_load_test.mbt", "frontier/frontier_test.mbt", "engine/fairness_test.mbt"]),
    ("protocol", ["retry/date_formats_test.mbt", "retry/retry_test.mbt", "security/resolver_test.mbt", "fetcher/headers_test.mbt"]),
    ("persistence", ["storage/journal_test.mbt", "storage/identity_test.mbt", "engine/failure_test.mbt"]),
    ("review-protocol", ["engine/review_test.mbt", "engine/engine_test.mbt", "parser/rel_test.mbt", "parser/parser_test.mbt", "robots/temporary_test.mbt"]),
    ("review-network", ["security/answers_test.mbt", "security/resolver_test.mbt", "fetcher/pinning_test.mbt", "fetcher/network_test.mbt", "fetcher/attack_test.mbt"]),
    ("review-scale", ["frontier/many_hosts_test.mbt", "storage/export_test.mbt"]),
    ("archive", ["storage/reader_test.mbt", "storage/catalog_wbtest.mbt", "storage/storage_test.mbt", "storage/README.mbt.md"]),
    ("wire-dns", ["engine/wire_dns_test.mbt"]),
  ]
  let rows : Array[Json] = []
  let logs : Array[(String, String)] = []
  let summary = StringBuilder()
  summary.write_string("# Focused test evidence — " + date + "\n\nTested source: `" + revision + "`\n\nFull suite: **not run**. Runner: " + platform + ". Selected project tests use native; orchestration uses MoonBit script mode. Results describe fixtures, not security certification.\n\n| Group | Exit | Elapsed ms | Raw log |\n| --- | ---: | ---: | --- |\n")
  let mut failed = false
  for (name, files) in groups {
    let args = ["test"]
    args.append(files)
    args.append(["--target", "native", "--warn-list", "-29-79"])
    let start = @env.now()
    let (code, log) = run("moon", args)
    let elapsed = @env.now() - start
    if code != 0 { failed = true }
    rows.push({"group": name, "arguments": @json.to_json(args), "exit_code": code, "wall_elapsed_ms": @json.to_json(elapsed)})
    logs.push((name + ".log", log))
    summary.write_string("| " + name + " | " + code.to_string() + " | " + elapsed.to_string() + " | [log](" + name + ".log) |\n")
  }
  let (model_code, model) = run("moon", ["run", "cmd/evidence", "--target", "native", "--quiet"])
  if model_code == 0 { @json.parse(model) |> ignore }
  let (cli_code, cli) = run("moon", ["run", "tools/cli_smoke.mbtx"])
  let (crash_code, crash) = run("moon", ["run", "tools/crash_probe.mbtx"])
  let (profile_code, profile) = run("moon", ["run", "tools/parser_profile.mbtx"])
  let (storage_code, storage_profile) = run("moon", ["run", "tools/storage_profile.mbtx"])
  if crash_code == 0 { @json.parse(crash) |> ignore }
  if profile_code == 0 { @json.parse(profile) |> ignore }
  if storage_code == 0 { @json.parse(storage_profile) |> ignore }
  if model_code != 0 || cli_code != 0 || crash_code != 0 || profile_code != 0 || storage_code != 0 { failed = true }
  let dir = "evidence/" + date
  @fs.mkdir(dir, recursive=true, allow_exist=true)
  for (path, data) in logs { @fs.write_file(dir + "/" + path, data) }
  @fs.write_file(dir + "/model.json", model)
  @fs.write_file(dir + "/cli.log", cli)
  @fs.write_file(dir + "/crash.json", crash)
  @fs.write_file(dir + "/parser-profile.json", profile)
  @fs.write_file(dir + "/storage-profile.json", storage_profile)
  let report : Json = {"source_revision": @json.to_json(revision), "source_dirty_at_start": @json.to_json(dirty), "full_suite": false, "orchestration_platform": @json.to_json(platform), "project_target": "native", "groups": @json.to_json(rows), "model_exit": @json.to_json(model_code), "cli_exit": @json.to_json(cli_code), "crash_probe_exit": @json.to_json(crash_code), "parser_profile_exit": @json.to_json(profile_code), "storage_profile_exit": @json.to_json(storage_code), "toolchain": @json.to_json(versions)}
  @fs.write_file(dir + "/results.json", report.stringify(indent=2))
  summary.write_string("\n[Machine-readable results](results.json) · [Queue models](model.json) · [CLI log](cli.log) · [Forced process termination](crash.json) · [Parser resource profile](parser-profile.json) · [Storage memory comparison](storage-profile.json)\n\nQueue inputs: 99,999 `https://a.example/{i}` tasks plus one `https://b.example/` task; separately 10,000 distinct `h{i}.example` hosts. No public network access. Candidate checks and wall duration are measured, not CPU time. Per-claim host scanning remains linear. The 65 MiB persistence test is an aggregate round-trip, not constant-memory operation.\n\nThe parser profile uses a fresh native debug process for each fixture: 2,000 nested divs; 600 malformed formatting groups; a 500,000-unit attribute; 60,000 entities. Counters include runtime/input generation; Windows records PeakWorkingSet64, Linux VmHWM, macOS only sampled RSS (not peak). A 30-second controller timeout stops stalled fixtures; these are not hard DOM allocation bounds.\n\nThe storage profile creates one 65-page checkpoint with exactly 1 MiB text per page, then runs full snapshot restoration/export and catalog streaming export in separate fresh native debug processes. It measures product-process working sets including runtime and buffers, not controller/generation memory. Both outputs are read incrementally and checked as 65 valid JSONL records. Throughput is fixture/filesystem dependent; this is not a production memory guarantee.\n\nCrash fixtures force SIGKILL/TerminateProcess at eleven stages, including partial event/shard/index writes and cleanup midway. This is not a power-cut or disk-cache-loss test. DNS fixtures exchange actual UDP A responses with TTL=0 and use real loopback HTTP/curl: a redirect triggers a new query and a dangerous answer is rejected. Mixed answers, transaction-ID mismatch and NXDOMAIN are checked. The fixture resolver is test-only; OS resolver caches, public authoritative infrastructure, CNAME and DNSSEC are not certified.\n")
  @fs.write_file(dir + "/README.md", summary.to_string())
  if failed { fail("Evidence includes failures; inspect logs") }
  println("Published local evidence files for " + revision)
}
