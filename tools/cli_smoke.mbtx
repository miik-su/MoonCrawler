----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/http",
  "moonbitlang/async@0.22.5/socket",
  "moonbitlang/async@0.22.5/shell",
}
----

async fn cli(args : Array[String]) -> String {
  let command = ["run", "cmd/mooncrawler", "--target", "native", "--"]
  command.append(args)
  let output = @shell.Cmd("moon", command).output(timeout_ms=60000, max_output_bytes=1048576)
  output.check()
  output.stdout()
}

async fn main {
  let dir = @fs.tmpdir(prefix="mooncrawler-cli-")
  defer @fs.rmdir(dir, recursive=true)
  ignore(cli(["init", dir + "/config.json"]))
  let config = @fs.read_file(dir + "/config.json").text()
    .replace(old="\"allowed_hosts\": []", new="\"allowed_hosts\": [\"127.0.0.1\"]")
    .replace(old="\"allow_loopback\": false", new="\"allow_loopback\": true")
    .replace(old="\"delay_ms\": 1000", new="\"delay_ms\": 0")
  @fs.write_file(dir + "/config.json", config)
  assert_true(cli(["validate", dir + "/config.json"]).contains("valid"))
  let server = @http.Server(@socket.Addr::parse("127.0.0.1:0"))
  defer server.close()
  let url = "http://127.0.0.1:\{server.addr.port()}/"
  let ns = " xmlns='http://www.sitemaps.org/schemas/sitemap/0.9'"
  let requests : Array[String] = []
  let mut revalidated = 0
  @async.with_task_group(group => {
    let serving = group.spawn(() => {
      server.run_forever((request, _reader, conn) => {
        requests.push(request.path)
        if request.path == "/" && request.headers.get("If-None-Match") == Some("\"home-1\"") {
          assert_eq(request.headers.get("If-Modified-Since"), Some("Sat, 01 Jan 2000 00:00:00 GMT"))
          revalidated += 1
          conn.send_response(304, "Not Modified", extra_headers={"ETag": "\"home-1\""})
          conn.end_response()
          return
        }
        let body = match request.path {
          "/robots.txt" => "User-agent: *\nDisallow: /private\nDisallow: /maps/blocked\nSitemap: " + url + "sitemap.xml"
          "/sitemap.xml" => "<sitemapindex" + ns + "><sitemap><loc>" + url + "maps/urls.xml</loc></sitemap></sitemapindex>"
          "/maps/urls.xml" => "<urlset" + ns + "><url><loc>" + url + "maps/page</loc></url><url><loc>" + url + "maps/page</loc></url><url><loc>" + url + "maps/blocked</loc></url><url><loc>" + url + "outside</loc></url><url><loc>https://example.com/page</loc></url></urlset>"
          "/" => "<title>CLI Home</title><a href='/next'>next</a><a href='/private'>private</a><a href='/'>cycle</a>"
          _ => "<title>CLI Next</title><p>中文</p>"
        }
        let headers : Map[@http.CaseInsensitiveString, String] = if request.path == "/" {
          {"Content-Type": "text/html; charset=utf-8", "ETag": "\"home-1\"", "Last-Modified": "Sat, 01 Jan 2000 00:00:00 GMT"}
        } else { {"Content-Type": "text/html; charset=utf-8"} }
        conn.send_response(200, "OK", extra_headers=headers)
        conn.write(body)
        conn.end_response()
      })
    }, no_wait=true)
    let result = cli(["crawl", dir + "/config.json", dir + "/job", url])
    assert_true(result.contains("saved 2 pages"))
    assert_false(requests.contains("/private"))
    let before = requests.length()
    assert_true(cli(["resume", dir + "/job"]).contains("saved 2 pages"))
    assert_eq(requests.length(), before)
    assert_true(cli(["status", dir + "/job"]).contains("pages"))
    let stats = cli(["stats", dir + "/job"])
    assert_true(stats.contains("\"task_attempts\":"))
    let metrics = cli(["stats", dir + "/job", "--prometheus"]).replace_all(old="\r\n", new="\n")
    assert_true(metrics.has_prefix("# TYPE mooncrawler_job_tasks gauge\n"))
    assert_true(metrics.contains("mooncrawler_job_tasks{state=\"succeeded\"} 2\n"))
    assert_true(metrics.contains("mooncrawler_job_tasks{state=\"running\"} 0\n"))
    assert_true(metrics.contains("mooncrawler_job_pages 2\n"))
    assert_true(metrics.has_suffix("mooncrawler_job_task_retries 0\n"))
    assert_false(metrics.contains(url))
    ignore(cli(["export", dir + "/job", dir + "/pages.jsonl"]))
    assert_eq(@fs.read_file(dir + "/pages.jsonl").text().split("\n").count(), 3)
    let revised = cli(["recrawl", dir + "/config.json", dir + "/revised", dir + "/job", url])
    assert_true(revised.contains("saved 2 pages"))
    assert_eq(revalidated, 1)
    ignore(cli(["export", dir + "/revised", dir + "/revised.jsonl"]))
    let old = @fs.read_file(dir + "/pages.jsonl").text().split("\n").map(s => s.to_owned()).to_array()
    let current = @fs.read_file(dir + "/revised.jsonl").text().split("\n").map(s => s.to_owned()).to_array()
    old.sort()
    current.sort()
    assert_eq(current, old)
    let discovered = cli(["crawl-robots", dir + "/config.json", dir + "/discovered", url])
    assert_true(discovered.contains("queued 2 Sitemap URLs"))
    assert_true(discovered.contains("saved 1 pages"))
    assert_true(requests.contains("/maps/page"))
    assert_false(requests.contains("/maps/blocked"))
    assert_false(requests.contains("/outside"))
    serving.cancel()
  })
  println("CLI smoke passed: crawl/resume/export 2 pages; JSON stats and Prometheus snapshot checked; conditional GET 304 preserved output; Robots Sitemap saved 1 allowed page")
}
